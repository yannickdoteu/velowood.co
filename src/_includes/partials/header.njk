{%- from "macros.njk" import logo, chevron -%}
{%- set anchor = "" if pageKey == "home" else home -%}
<header class="vw-header">
  <div class="vw-container vw-header__inner">
    <a class="vw-header__logo" href="{{ home }}" aria-label="{{ t.site.homeLabel }}">{{ logo(images.logo, "") }}</a>
    <nav class="vw-nav" id="site-nav" aria-label="{{ t.nav.label }}">
      <a href="{{ anchor }}#bicycles">{{ t.nav.bicycles }}</a>
      <a href="{{ anchor }}#why-wood">{{ t.nav.whyWood }}</a>
      <a href="{{ anchor }}#workshop">{{ t.nav.workshop }}</a>
      <a href="{{ anchor }}#hotels">{{ t.nav.hotels }}</a>
      <a class="vw-nav__cta" href="{{ anchor }}#contact">{{ t.nav.contact }}</a>
    </nav>
    <div class="vw-header__actions">
      <div class="vw-lang" data-lang-switcher>
        <button class="vw-lang__btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="lang-menu" aria-label="{{ t.site.languageLabel }}">{{ t.meta.code | upper }} {{ chevron() }}</button>
        <ul class="vw-lang__menu" id="lang-menu" hidden>
          {%- for l in languages %}
          <li><a href="{{ l | pageUrl(pageKey) }}" hreflang="{{ l.meta.hreflang }}" lang="{{ l.meta.hreflang }}"{% if l.meta.code == t.meta.code %} aria-current="true"{% endif %}>{{ l.meta.name }} <span aria-hidden="true">{{ l.meta.code | upper }}</span></a></li>
          {%- endfor %}
        </ul>
      </div>
      <a class="vw-btn vw-btn--sm vw-header__cta" href="{{ anchor }}#contact">{{ t.nav.contact }}</a>
      <button class="vw-menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-label-open="{{ t.site.menu }}" data-label-close="{{ t.site.closeMenu }}" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false"><path class="vw-menu-btn__open" d="M4 7h16M4 12h16M4 17h16"/><path class="vw-menu-btn__close" d="M6 6l12 12M18 6 6 18"/></svg>
        <span class="vw-visually-hidden">{{ t.site.menu }}</span>
      </button>
    </div>
  </div>
</header>
