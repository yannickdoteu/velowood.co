{
  "name": "velowood-site",
  "private": true,
  "type": "module",
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "build": "eleventy",
    "dev": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply velowood-contact --local",
    "db:migrate:remote": "wrangler d1 migrations apply velowood-contact --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "worker-mailer": "^1.3.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "js-yaml": "^5.5.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  }
}
